# Copy to .env. Never commit the populated file.
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
# Cloud URL. Locally VITE_CONVEX_URL from Convex's .env.local is also accepted.
CONVEX_URL=
# Private server-only secret matching STUDIO_SERVER_KEY in Convex. Never use VITE_.
CONVEX_SERVER_KEY=
# Only during cutover; matches temporary STUDIO_MIGRATION_KEY in Convex.
CONVEX_MIGRATION_KEY=
# Development sample availability is blocked outside development.
DEVELOPMENT_AVAILABILITY=true
# Explicit TEST amounts in paise and durations in minutes. Leave unset until agreed.
ONLINE_TEST_PRICE_PAISE=
ONLINE_DURATION_MINUTES=
ONLINE_TEST_TAX_PAISE=
STUDIO_TEST_PRICE_PAISE=
STUDIO_DURATION_MINUTES=
STUDIO_TEST_TAX_PAISE=
PRIVATE_TEST_PRICE_PAISE=
PRIVATE_DURATION_MINUTES=
PRIVATE_TEST_TAX_PAISE=
# Test keys only. Live keys are rejected.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Leave unset until verified. No contact details are inferred from reference sites.
STUDIO_EMAIL=
STUDIO_PHONE=
STUDIO_ADDRESS=
# Contact queries are saved to Convex and emailed to the studio.
# The recipient is bhoomikameghani0110@gmail.com unless CONTACT_NOTIFY_EMAIL is set.
# Sending Gmail SMTP: SMTP_USER is the sender Gmail account and SMTP_APP_PASSWORD
# is an App Password (myaccount.google.com/apppasswords), never the login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
CONTACT_NOTIFY_EMAIL=
