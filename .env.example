# Copy to .env. Never commit the populated file.
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE=instance/studio.sqlite3
# Development sample availability is blocked outside development.
DEVELOPMENT_AVAILABILITY=true
# Explicit TEST amounts in paise and durations in minutes. Leave unset until agreed.
ONLINE_TEST_PRICE_PAISE=
ONLINE_DURATION_MINUTES=
ONLINE_TEST_TAX_PAISE=
STUDIO_TEST_PRICE_PAISE=
STUDIO_DURATION_MINUTES=
STUDIO_TEST_TAX_PAISE=
PRIVATE_TEST_PRICE_PAISE=
PRIVATE_DURATION_MINUTES=
PRIVATE_TEST_TAX_PAISE=
# Test keys only. Live keys are rejected.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Leave unset until verified. No contact details are inferred from reference sites.
STUDIO_EMAIL=
STUDIO_PHONE=
STUDIO_ADDRESS=
